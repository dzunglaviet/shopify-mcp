# ============================================================
# iMat Shopify Skill — Cấu hình
# Sao chép file này thành .env và điền thông tin của bạn
# ============================================================

# --- Shopify API version ---
SHOPIFY_API_VERSION=2026-04

# ============================================================
# CẤU HÌNH 1 STORE (đơn giản nhất)
# ============================================================

SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Cách A — Static token (Custom App → API credentials → Install → copy shpat_...)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cách B — OAuth (dùng thay cho Cách A, không cần cả hai)
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret

# ============================================================
# CẤU HÌNH NHIỀU STORE (JSON array, thay thế cấu hình trên)
# ============================================================
# SHOPIFY_STORES=[
#   {
#     "shop_domain": "store1.myshopify.com",
#     "access_token": "shpat_aaa..."
#   },
#   {
#     "shop_domain": "store2.myshopify.com",
#     "client_id": "abc123",
#     "client_secret": "xyz456"
#   }
# ]
